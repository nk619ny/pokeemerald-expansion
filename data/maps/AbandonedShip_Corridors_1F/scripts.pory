raw `
AbandonedShip_Corridors_1F_MapScripts::
	.byte 0

AbandonedShip_Corridors_1F_EventScript_Youngster::
	msgbox AbandonedShip_Corridors_1F_Text_IsntItFunHere, MSGBOX_NPC
	end

/*
AbandonedShip_Corridors_1F_EventScript_Charlie::
	trainerbattle_single TRAINER_CHARLIE, AbandonedShip_Corridors_1F_Text_CharlieIntro, AbandonedShip_Corridors_1F_Text_CharlieDefeat
	msgbox AbandonedShip_Corridors_1F_Text_CharliePostBattle, MSGBOX_AUTOCLOSE
	end
*/

AbandonedShip_Corridors_1F_Text_CharlieIntro:
	.string "What's so funny about having my inner\n"
	.string "tube aboard the ship?$"

AbandonedShip_Corridors_1F_Text_CharlieDefeat:
	.string "Whoa, you overwhelmed me!$"

AbandonedShip_Corridors_1F_Text_CharliePostBattle:
	.string "It's not easy throwing POKé BALLS\n"
	.string "while hanging on to an inner tube!$"

AbandonedShip_Corridors_1F_Text_IsntItFunHere:
	.string "Isn't it fun here?\n"
	.string "I get excited just being here!$"
`


script AbandonedShip_Corridors_1F_EventScript_Charlie {
    trainerbattle_single(TRAINER_CHARLIE, AbandonedShip_Corridors_1F_Text_CharlieIntro, AbandonedShip_Corridors_1F_Text_CharlieDefeat, AbandonedShip_Corridors_1F_EventScript_CharlieTryGiveVitamin)
    goto_if_set(FLAG_TEMP_A, AbandonedShip_Corridors_1F_EventScript_CharlieTryGiveVitamin)
	msgbox(AbandonedShip_Corridors_1F_Text_CharliePostBattle, MSGBOX_NPC)
    release
    end
}

script AbandonedShip_Corridors_1F_EventScript_CharlieTryGiveVitamin{
	if(flag(FLAG_BADGE05_GET)==TRUE){
		releaseall
		end
	}
	if(flag(FLAG_TEMP_A) == FALSE) {
		msgbox(format("I found some old junk left behind on the boat.\pBut my Dad says I'm not allowed to bring trash from the ship home anymore.\pDo you want it?"), MSGBOX_NPC)
	}
	else {
		msgbox(format("Did you decide to take the stuff I found?"), MSGBOX_NPC)
	}
	checkitemspace(ITEM_HP_UP)
	if(var(VAR_RESULT) == TRUE) {
		giveitem(ITEM_HP_UP)
		clearflag(FLAG_TEMP_A)
	}
	else {
		setflag(FLAG_TEMP_A)
		msgbox(format("You don't want it either?\pI guess Dad was right."), MSGBOX_NPC)
	}
	release
	end
}