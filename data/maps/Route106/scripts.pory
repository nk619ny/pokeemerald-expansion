raw `
Route106_MapScripts::
	.byte 0

Route106_EventScript_TrainerTipsSign::
	msgbox Route106_Text_TrainerTips, MSGBOX_SIGN
	end

/*
Route106_EventScript_Douglas::
	trainerbattle_single TRAINER_DOUGLAS, Route106_Text_DouglasIntro, Route106_Text_DouglasDefeated
	msgbox Route106_Text_DouglasPostBattle, MSGBOX_AUTOCLOSE
	end
*/

Route106_EventScript_Kyla::
	trainerbattle_single TRAINER_KYLA, Route106_Text_KylaIntro, Route106_Text_KylaDefeated
	msgbox Route106_Text_KylaPostBattle, MSGBOX_AUTOCLOSE
	end

Route106_EventScript_Elliot::
	trainerbattle_single TRAINER_ELLIOT_1, Route106_Text_ElliotIntro_New, Route106_Text_ElliotDefeated_New
	msgbox Route106_Text_ElliotPostBattle_New, MSGBOX_DEFAULT
	release
	end

Route106_EventScript_ElliotRematch::
	trainerbattle_rematch TRAINER_ELLIOT_1, Route106_Text_ElliotRematchIntro, Route106_Text_ElliotRematchDefeated
	msgbox Route106_Text_ElliotRematchPostBattle, MSGBOX_AUTOCLOSE
	end

Route106_EventScript_Ned::
	trainerbattle_single TRAINER_NED, Route106_Text_NedIntro, Route106_Text_NedDefeated
	msgbox Route106_Text_NedPostBattle, MSGBOX_AUTOCLOSE
	end

Route106_Text_TrainerTips:
	.string "TRAINER TIPS\p"
	.string "Advice on catching Pokémon with a ROD:\n"
	.string "Press the A Button if you get a bite.$"

`

text Route106_Text_ElliotIntro_New {
	format("Which do you prefer, hiking in the mountains or a stroll on the beach?")
}

text Route106_Text_ElliotDefeated_New {
	format("Like in cave delving, I lost spectacularly!")
}

text Route106_Text_ElliotPostBattle_New {
	format("Hiking is the greatest whether it's in the high mountains or deep underground. You agree with me, right?")
}



script Route106_EventScript_Douglas {
    trainerbattle_single(TRAINER_DOUGLAS, Route106_Text_DouglasIntro, Route106_Text_DouglasDefeated, Route106_EventScript_DouglasTryGiveVitamin)
    goto_if_set(FLAG_TEMP_A, Route106_EventScript_DouglasTryGiveVitamin)
	msgbox(Route106_Text_DouglasPostBattle, MSGBOX_AUTOCLOSE)
    release
    end
}

script Route106_EventScript_DouglasTryGiveVitamin{
	if(flag(FLAG_BADGE05_GET)==TRUE){
		releaseall
		end
	}
	if(flag(FLAG_TEMP_A) == FALSE) {
		msgbox(format("I've battled trainers who were swimming, and trainers surfing on Pokémon, but never a trainer in a boat before.\pTake this as thanks for the new experience!"), MSGBOX_NPC)
	}
	else {
		msgbox(format("Oh hey, it's the guy on the boat again!"), MSGBOX_NPC)
	}
	checkitemspace(ITEM_CALCIUM)
	if(var(VAR_RESULT) == TRUE) {
		giveitem(ITEM_CALCIUM)
		clearflag(FLAG_TEMP_A)
	}
	else {
		setflag(FLAG_TEMP_A)
		msgbox(format("Would this vitamin weigh down your boat too much?\pTry dropping some weight and come back."), MSGBOX_NPC)
	}
	release
	end
}