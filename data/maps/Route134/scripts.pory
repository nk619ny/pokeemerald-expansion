script Route134_EventScript_Marley {
    trainerbattle_single(TRAINER_MARLEY, Route134_Text_MarleyIntro, Route134_Text_MarleyDefeat, Route134_EventScript_MarleyTryGiveVitamin)
    goto_if_set(FLAG_TEMP_A, Route134_EventScript_MarleyTryGiveVitamin)
	msgbox(Route134_Text_MarleyPostBattle, MSGBOX_NPC)
    release
    end
}

script Route134_EventScript_MarleyTryGiveVitamin{
	if(flag(FLAG_BADGE08_GET)==TRUE){
		releaseall
		end
	}
	if(flag(FLAG_TEMP_A) == FALSE) {
		msgbox(format("We train here because only the elite can weather these currents, and so we always practice against the best.\pCustom dictates powerful trainers should reward each other for their victory. Take this."), MSGBOX_NPC)
	}
	else {
		msgbox(format("Here, take this."), MSGBOX_NPC)
	}
	checkitemspace(ITEM_HEART_SCALE)
	if(var(VAR_RESULT) == TRUE) {
		giveitem(ITEM_HEART_SCALE)
		clearflag(FLAG_TEMP_A)
	}
	else {
		setflag(ITEM_HEART_SCALE)
		msgbox(format("Look, I'm not just going to hold onto this for you.\pEither take it right now, or don't bother."), MSGBOX_NPC)
	}
	release
	end
}